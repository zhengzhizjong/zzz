.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 体质辨识卡片 */
.constitution-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.constitution-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.constitution-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.constitution-tag {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.constitution-tag-text {
  font-size: 24rpx;
  color: #ffffff;
}

.constitution-desc {
  padding: 16rpx 20rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
}

.constitution-desc-text {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
}

/* 表单卡片 */
.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
  margin-bottom: 24rpx;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EBEEF5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-column {
  display: flex;
  flex-direction: column;
}

.form-label {
  font-size: 28rpx;
  color: #303133;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #303133;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 保存按钮 */
.save-btn {
  margin: 0 24rpx 24rpx;
}

.save-btn[disabled] {
  opacity: 0.6;
}

/* AI体质辨识按钮 */
.ai-btn {
  margin: 0 24rpx 24rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.ai-btn::after {
  border: none;
}

.ai-btn-text {
  font-size: 32rpx;
  color: #ffffff;
}
