/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  height: 48rpx;
  line-height: 48rpx;
}

.search-placeholder {
  color: #C0C4CC;
  font-size: 28rpx;
}

/* 门店列表 */
.store-list {
  padding: 0 24rpx;
}

/* 门店卡片 */
.store-card {
  margin-bottom: 24rpx;
}

.store-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 营业状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.status-open {
  color: #07C160;
  background-color: rgba(7, 193, 96, 0.1);
}

.status-closed {
  color: #FA5151;
  background-color: rgba(250, 81, 81, 0.1);
}

/* 门店信息 */
.store-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
}

.info-label {
  font-size: 24rpx;
  color: #909399;
  margin-right: 16rpx;
  white-space: nowrap;
}

.info-value {
  font-size: 24rpx;
  color: #606266;
  flex: 1;
  line-height: 1.5;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #C0C4CC;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #C0C4CC;
}
