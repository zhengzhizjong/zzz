.payment-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #909399;
}

.amount-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.amount-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 16rpx;
}

.amount-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-symbol {
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
  margin-right: 4rpx;
}

.amount-number {
  font-size: 72rpx;
  color: #fff;
  font-weight: bold;
}

.order-info {
  padding: 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F2F6FC;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #909399;
}

.info-value {
  font-size: 28rpx;
  color: #303133;
  max-width: 400rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pay-action {
  margin-top: 48rpx;
  padding: 0 16rpx;
}

.pay-btn {
  width: 100%;
}
