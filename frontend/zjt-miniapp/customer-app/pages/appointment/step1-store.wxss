.container {
  padding-bottom: 140rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.step-bar {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #EBEEF5;
}

.step {
  font-size: 24rpx;
  color: #909399;
}

.step.active {
  color: #07C160;
  font-weight: bold;
}

.step.done {
  color: #07C160;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 1rpx solid #DCDFE6;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  height: 48rpx;
}

/* 门店列表 */
.store-list {
  padding: 24rpx;
}

.store-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.store-card.selected {
  border-color: #07C160;
  box-shadow: 0 0 0 2rpx rgba(7, 193, 96, 0.15);
}

.store-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-tag.open {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.status-tag.closed {
  background: rgba(245, 108, 108, 0.1);
  color: #F56C6C;
}

.store-info {
  margin-top: 8rpx;
}

.store-address,
.store-hours {
  font-size: 26rpx;
  color: #606266;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #C0C4CC;
  font-size: 28rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  color: #909399;
  font-size: 28rpx;
}

/* 底部按钮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn-next {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  text-align: center;
}

.btn-next.disabled {
  background: #C0C4CC;
  color: #fff;
}

.btn-next[disabled] {
  background: #C0C4CC;
  color: #fff;
}
