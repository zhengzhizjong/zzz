/* 遮罩层 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 弹窗内容 */
.popup-content {
  width: 100%;
  max-height: 85vh;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

/* 标题栏 */
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 40rpx;
  color: #909399;
  line-height: 1;
}

/* 区块 */
.section {
  margin-bottom: 28rpx;
}

.section-label {
  font-size: 28rpx;
  color: #303133;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: #F56C6C;
}

/* 原预约信息 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-key {
  font-size: 26rpx;
  color: #909399;
  flex-shrink: 0;
}

.info-val {
  font-size: 26rpx;
  color: #303133;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

/* 日期选择 */
.date-scroll {
  white-space: nowrap;
  width: 100%;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #F5F5F5;
  margin-right: 16rpx;
  transition: all 0.2s;
}

.date-week {
  font-size: 22rpx;
  color: #909399;
  margin-bottom: 4rpx;
}

.date-day {
  font-size: 26rpx;
  color: #303133;
}

.date-active {
  background-color: #07C160;
}

.date-active .date-week,
.date-active .date-day {
  color: #ffffff;
}

/* 时段选择网格 */
.slot-grid {
  display: flex;
  flex-wrap: wrap;
}

.slot-item {
  width: calc(25% - 12rpx);
  margin: 6rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  background-color: #F5F5F5;
  font-size: 24rpx;
  color: #303133;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.slot-active {
  background-color: #F0F9EB;
  color: #07C160;
  border-color: #07C160;
}

.slot-disabled {
  background-color: #F5F5F5;
  color: #C0C4CC;
  text-decoration: line-through;
}

/* 修改原因输入框 */
.reason-input {
  width: 100%;
  height: 160rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #303133;
  box-sizing: border-box;
}

/* 底部按钮 */
.popup-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn::after {
  border: none;
}

.btn-default {
  background-color: #F5F5F5;
  color: #606266;
  margin-right: 20rpx;
}

.btn-primary {
  background-color: #07C160;
  color: #ffffff;
}
