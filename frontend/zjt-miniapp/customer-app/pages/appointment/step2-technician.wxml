<view class="container">
  <view class="step-bar">
    <text class="step done">1 选择门店</text>
    <text class="step active">2 选择技师</text>
    <text class="step">3 选择时间</text>
    <text class="step">4 确认预约</text>
  </view>

  <!-- 已选门店 -->
  <view class="selected-store-bar">
    <text class="selected-store-label">已选门店：</text>
    <text class="selected-store-name">{{storeName}}</text>
  </view>

  <!-- 不指定技师选项 -->
  <view class="no-tech-card {{selectedTechId === 0 ? 'selected' : ''}}" bindtap="onNoTechTap">
    <view class="no-tech-left">
      <view class="no-tech-avatar">
        <text class="no-tech-icon">👤</text>
      </view>
      <text class="no-tech-name">不指定技师</text>
    </view>
    <view class="check-icon" wx:if="{{selectedTechId === 0}}">✅</view>
  </view>

  <!-- 技师卡片列表 -->
  <view class="tech-list" wx:if="{{!loading}}">
    <view class="tech-card {{selectedTechId === item.id ? 'selected' : ''}} {{item.isFull ? 'full' : ''}}"
          wx:for="{{technicianList}}" wx:key="id"
          data-id="{{item.id}}" data-name="{{item.name}}" data-full="{{item.isFull}}"
          bindtap="onTechnicianTap">
      <!-- 约满遮罩 -->
      <view class="full-mask" wx:if="{{item.isFull}}">
        <text class="full-text">约满</text>
      </view>

      <view class="tech-content">
        <view class="tech-left">
          <!-- 头像 -->
          <view class="tech-avatar-wrap">
            <image class="tech-avatar" src="{{item.avatarUrl || '/assets/icons/default-avatar.png'}}" mode="aspectFill" />
            <view class="online-dot {{item.onDuty ? 'online' : 'offline'}}"></view>
          </view>
        </view>

        <view class="tech-info">
          <view class="tech-name-row">
            <text class="tech-name">{{item.name}}</text>
            <view class="level-tag" wx:if="{{item.levelName}}">{{item.levelName}}</view>
          </view>
          <view class="tech-rating" wx:if="{{item.rating}}">
            <text class="rating-star">⭐</text>
            <text class="rating-value">{{item.rating}}</text>
          </view>
          <view class="tech-skills" wx:if="{{item.skillTags && item.skillTags.length}}">
            <text class="skill-tag" wx:for="{{item.skillTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{technicianList.length === 0}}">
      <text>暂无技师信息</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 底部下一步按钮 -->
  <view class="bottom-bar">
    <button class="btn-next" bindtap="onNextStep">下一步</button>
  </view>
</view>
