/* 营收卡片 */
.revenue-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.revenue-label {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
  margin-bottom: 12rpx;
}

.revenue-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.revenue-symbol {
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 4rpx;
}

.revenue-value {
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1;
}

.target-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.target-text {
  font-size: 24rpx;
  opacity: 0.85;
}

.target-percent {
  font-size: 28rpx;
  font-weight: bold;
}

.target-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.target-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 4宫格 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.stat-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  box-sizing: border-box;
}

.stat-item:nth-child(1),
.stat-item:nth-child(2) {
  border-bottom: 1rpx solid #F2F6FC;
}

.stat-item:nth-child(1),
.stat-item:nth-child(3) {
  border-right: 1rpx solid #F2F6FC;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #303133;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #909399;
}

/* 趋势图预留 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.chart-placeholder {
  padding: 20rpx 0;
}

.placeholder-text {
  display: block;
  text-align: center;
  color: #C0C4CC;
  padding: 40rpx 0;
}
