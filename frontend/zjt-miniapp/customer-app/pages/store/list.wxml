<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
      <input
        class="search-input"
        placeholder="搜索门店名称"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
    </view>
  </view>

  <!-- 门店卡片列表 -->
  <view class="store-list">
    <view
      class="store-card card"
      wx:for="{{stores}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onStoreTap"
    >
      <view class="store-header">
        <text class="store-name">{{item.name}}</text>
        <view class="status-tag {{item.businessStatus === 'open' ? 'status-open' : 'status-closed'}}">
          {{item.businessStatus === 'open' ? '营业中' : '已打烊'}}
        </view>
      </view>
      <view class="store-info">
        <view class="info-row">
          <text class="info-label">地址</text>
          <text class="info-value">{{item.address || '暂无地址信息'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">时间</text>
          <text class="info-value">{{item.businessHours || '暂无营业时间'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && stores.length === 0}}">
    <text class="empty-text">暂无门店信息</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading}}">
    <text class="load-more-text">加载中...</text>
  </view>
  <view class="load-more" wx:elif="{{!hasMore && stores.length > 0}}">
    <text class="load-more-text">没有更多了</text>
  </view>
</view>
