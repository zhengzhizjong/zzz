<view class="container">
  <view class="step-bar">
    <text class="step done">1 选择门店</text>
    <text class="step done">2 选择技师</text>
    <text class="step done">3 选择时间</text>
    <text class="step active">4 确认预约</text>
  </view>

  <!-- 5分钟倒计时 -->
  <view class="countdown-bar {{countdownWarning ? 'warning' : ''}}">
    <text class="countdown-text">请在 {{countdownDisplay}} 内完成预约</text>
  </view>

  <!-- 预约摘要卡片 -->
  <view class="summary-card">
    <view class="summary-title">预约摘要</view>

    <view class="info-row">
      <text class="info-label"><text class="required">*</text> 门店</text>
      <text class="info-value">{{storeName || '--'}}</text>
    </view>

    <view class="info-row">
      <text class="info-label"><text class="required">*</text> 技师</text>
      <text class="info-value">{{techName || '--'}}</text>
    </view>

    <view class="info-row">
      <text class="info-label"><text class="required">*</text> 日期</text>
      <text class="info-value">{{date || '--'}}</text>
    </view>

    <view class="info-row">
      <text class="info-label"><text class="required">*</text> 时段</text>
      <text class="info-value">{{timeSlot || '--'}}</text>
    </view>

    <!-- 服务项目（可选） -->
    <view class="service-section" wx:if="{{serviceItems.length > 0}}">
      <view class="info-row service-header">
        <text class="info-label">项目</text>
        <text class="info-value optional-tag">可选</text>
      </view>
      <view class="service-list">
        <view class="service-item {{selectedServiceItemId === item.id ? 'selected' : ''}}"
              wx:for="{{serviceItems}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onServiceItemTap">
          <text class="service-name">{{item.name}}</text>
          <text class="service-price" wx:if="{{item.price}}">¥{{item.price}}</text>
          <view class="service-check" wx:if="{{selectedServiceItemId === item.id}}">✓</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 确认预约按钮 -->
  <view class="bottom-bar">
    <button class="btn-submit {{(!storeId || !date || !timeSlot || !lockId) ? 'disabled' : ''}}"
            bindtap="onSubmit"
            disabled="{{!storeId || !date || !timeSlot || !lockId || submitting}}"
            loading="{{submitting}}">
      确认预约
    </button>
  </view>
</view>
