.container {
  padding-bottom: 160rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.step-bar {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #EBEEF5;
}

.step {
  font-size: 24rpx;
  color: #909399;
}

.step.active {
  color: #07C160;
  font-weight: bold;
}

.step.done {
  color: #07C160;
}

/* 倒计时 */
.countdown-bar {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 28rpx;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 8rpx;
  text-align: center;
}

.countdown-bar.warning {
  background: rgba(245, 108, 108, 0.08);
}

.countdown-text {
  font-size: 28rpx;
  color: #07C160;
  font-weight: bold;
}

.countdown-bar.warning .countdown-text {
  color: #F56C6C;
}

/* 预约摘要卡片 */
.summary-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 28rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EBEEF5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #909399;
  font-size: 28rpx;
}

.required {
  color: #F56C6C;
  font-size: 28rpx;
}

.info-value {
  color: #303133;
  font-size: 28rpx;
  font-weight: bold;
}

.optional-tag {
  color: #C0C4CC;
  font-size: 22rpx;
  font-weight: normal;
  background: #F5F7FA;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

/* 服务项目 */
.service-section {
  margin-top: 8rpx;
}

.service-header {
  border-bottom: none;
  padding-bottom: 12rpx;
}

.service-list {
  border-top: 1rpx solid #EBEEF5;
  padding-top: 12rpx;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #F5F7FA;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
}

.service-item.selected {
  border-color: #07C160;
  background: rgba(7, 193, 96, 0.05);
}

.service-name {
  flex: 1;
  font-size: 26rpx;
  color: #303133;
}

.service-price {
  font-size: 26rpx;
  color: #F56C6C;
  margin-right: 16rpx;
}

.service-check {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #07C160;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
}

/* 底部按钮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  text-align: center;
}

.btn-submit.disabled {
  background: #C0C4CC;
  color: #fff;
}

.btn-submit[disabled] {
  background: #C0C4CC;
  color: #fff;
}
