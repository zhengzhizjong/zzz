/* 推广信息卡片 */
.promo-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.promo-header {
  margin-bottom: 24rpx;
}

.promo-code-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.promo-code-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-right: 16rpx;
}

.promo-code {
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.promo-share-link {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.share-link-text {
  font-size: 22rpx;
  opacity: 0.9;
  word-break: break-all;
}

.promo-stats-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.promo-stat {
  flex: 1;
  text-align: center;
}

.promo-stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.promo-stat-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
}

.promo-stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.promo-actions {
  display: flex;
  gap: 16rpx;
}

.promo-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-radius: 40rpx;
  border: none;
  line-height: 1.4;
}

.promo-btn::after {
  border: none;
}

.poster-btn {
  background: #fff;
  color: #07C160;
}

.share-btn {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #909399;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-item.tab-active {
  color: #07C160;
  background: rgba(7, 193, 96, 0.1);
  font-weight: bold;
}

/* 推广数据4宫格 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stats-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  box-sizing: border-box;
}

.stats-item:nth-child(1),
.stats-item:nth-child(2) {
  border-bottom: 1rpx solid #F2F6FC;
}

.stats-item:nth-child(1),
.stats-item:nth-child(3) {
  border-right: 1rpx solid #F2F6FC;
}

.stats-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #303133;
  margin-bottom: 6rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #909399;
}

/* 佣金明细 */
.commission-summary {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.commission-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.commission-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-settled {
  background: #07C160;
}

.dot-pending {
  background: #FF9D00;
}

.commission-label {
  font-size: 26rpx;
  color: #909399;
}

.commission-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #303133;
}

.commission-list {
  margin-top: 8rpx;
}

.commission-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F6FC;
}

.commission-row:last-child {
  border-bottom: none;
}

.commission-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.commission-name {
  font-size: 28rpx;
  color: #303133;
  font-weight: 500;
}

.commission-date {
  font-size: 22rpx;
  color: #C0C4CC;
}

.commission-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.commission-amount-row {
  font-size: 28rpx;
  font-weight: bold;
}

.amount-settled {
  color: #07C160;
}

.amount-pending {
  color: #FF9D00;
}

.commission-status {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.status-settled {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.status-pending {
  background: rgba(255, 157, 0, 0.1);
  color: #FF9D00;
}

/* 排行榜 */
.ranking-list {
  margin-top: 8rpx;
}

.ranking-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #EBEEF5;
}

.ranking-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F6FC;
}

.ranking-row:last-child {
  border-bottom: none;
}

.ranking-col {
  font-size: 26rpx;
  color: #606266;
}

.ranking-header .ranking-col {
  font-size: 24rpx;
  color: #909399;
  font-weight: 500;
}

.rank-col {
  width: 80rpx;
  text-align: center;
}

.name-col {
  flex: 1;
}

.count-col {
  width: 120rpx;
  text-align: center;
}

.amount-col {
  width: 140rpx;
  text-align: center;
}

.change-col {
  width: 80rpx;
  text-align: center;
}

.rank-top {
  color: #07C160;
  font-weight: bold;
}

.change-up {
  color: #07C160;
}

.change-down {
  color: #FA5151;
}

.change-same {
  color: #909399;
}

/* 通用 */
.empty-tip {
  padding: 20rpx 0;
}

.placeholder-text {
  display: block;
  text-align: center;
  color: #C0C4CC;
  padding: 40rpx 0;
}
