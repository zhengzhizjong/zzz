<view class="popup-mask" wx:if="{{visible}}" bindtap="onMaskTap">
  <view class="popup-content" catchtap="preventBubble">
    <!-- 标题 -->
    <view class="popup-header">
      <text class="popup-title">取消预约</text>
      <view class="popup-close" bindtap="onClose">
        <text class="close-icon">×</text>
      </view>
    </view>

    <!-- 预约信息摘要 -->
    <view class="summary-section" wx:if="{{appointment}}">
      <view class="summary-row">
        <text class="summary-key">门店</text>
        <text class="summary-val">{{appointment.storeName}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-key">服务项目</text>
        <text class="summary-val">{{appointment.serviceItemName || '-'}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-key">日期</text>
        <text class="summary-val">{{appointment.date}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-key">时段</text>
        <text class="summary-val">{{appointment.timeSlot}}</text>
      </view>
    </view>

    <!-- 取消原因单选列表 -->
    <view class="section">
      <text class="section-label">取消原因</text>
      <view class="reason-list">
        <view
          class="reason-item {{selectedReason === item ? 'reason-active' : ''}}"
          wx:for="{{reasonOptions}}"
          wx:key="*this"
          data-reason="{{item}}"
          bindtap="onReasonTap"
        >
          <view class="radio-circle">
            <view class="radio-dot" wx:if="{{selectedReason === item}}"></view>
          </view>
          <text class="reason-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- "其他"输入框 -->
    <view class="section" wx:if="{{selectedReason === '其他'}}">
      <textarea
        class="other-input"
        placeholder="请填写取消原因"
        value="{{otherReason}}"
        bindinput="onOtherReasonInput"
        maxlength="200"
      ></textarea>
    </view>

    <!-- 确认/取消按钮 -->
    <view class="popup-footer">
      <button class="btn btn-default" bindtap="onClose">返回</button>
      <button class="btn btn-danger" bindtap="onSubmit" loading="{{submitting}}">确认取消</button>
    </view>
  </view>
</view>
