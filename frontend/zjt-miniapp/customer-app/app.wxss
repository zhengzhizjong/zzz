page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 主题色 */
.theme-primary {
  color: #07C160;
}

.theme-warning {
  color: #FF9D00;
}

.theme-danger {
  color: #FA5151;
}

/* 背景色 */
.bg-primary {
  background-color: #07C160;
}

.bg-page {
  background-color: #F5F5F5;
}

.bg-white {
  background-color: #FFFFFF;
}

/* 文字色 */
.text-primary {
  color: #303133;
}

.text-regular {
  color: #606266;
}

.text-secondary {
  color: #909399;
}

.text-placeholder {
  color: #C0C4CC;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 通用按钮 */
.btn-primary {
  background-color: #07C160;
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
}

.btn-primary::after {
  border: none;
}

/* Flex 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}
