.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  background-color: #ffffff;
  margin-bottom: 24rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.avatar-edit-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #07C160;
}

/* 表单卡片 */
.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 24rpx 32rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #EBEEF5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #303133;
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #303133;
  text-align: right;
}

.form-input-readonly {
  color: #909399;
}

.form-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.picker-text {
  font-size: 28rpx;
  color: #303133;
}

.picker-arrow {
  font-size: 32rpx;
  color: #C0C4CC;
  margin-left: 12rpx;
}

/* 保存按钮 */
.save-btn {
  margin: 0 24rpx;
  margin-top: 48rpx;
}

.save-btn[disabled] {
  opacity: 0.6;
}
