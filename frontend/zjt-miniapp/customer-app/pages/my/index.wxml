<view class="container">
  <view class="profile-card">
    <view class="avatar-wrapper">
      <image class="avatar" src="{{userInfo.avatar || '/assets/icons/user.png'}}" mode="aspectFill" />
    </view>
    <block wx:if="{{isLogin}}">
      <text class="nickname">{{userInfo.nickname || '忠济堂会员'}}</text>
      <text class="member-level" wx:if="{{userInfo.levelName}}">{{userInfo.levelName}}</text>
    </block>
    <block wx:else>
      <button class="login-btn" bindtap="goLogin">点击登录</button>
    </block>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="goAppointment">
      <text class="menu-text">我的预约</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goHealthProfile">
      <text class="menu-text">健康档案</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCouponList">
      <text class="menu-text">我的优惠券</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goTreatmentList">
      <text class="menu-text">我的疗程卡</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goProfileEdit">
      <text class="menu-text">个人信息编辑</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button wx:if="{{isLogin}}" class="logout-btn" bindtap="handleLogout">退出登录</button>
</view>
