.container {
  padding-bottom: 140rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.step-bar {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #EBEEF5;
}

.step {
  font-size: 24rpx;
  color: #909399;
}

.step.active {
  color: #07C160;
  font-weight: bold;
}

.step.done {
  color: #07C160;
}

/* 已选门店 */
.selected-store-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 8rpx;
}

.selected-store-label {
  font-size: 26rpx;
  color: #909399;
}

.selected-store-name {
  font-size: 26rpx;
  color: #303133;
  font-weight: bold;
}

/* 不指定技师 */
.no-tech-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
}

.no-tech-card.selected {
  border-color: #07C160;
  box-shadow: 0 0 0 2rpx rgba(7, 193, 96, 0.15);
}

.no-tech-left {
  display: flex;
  align-items: center;
}

.no-tech-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F0F2F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.no-tech-icon {
  font-size: 36rpx;
}

.no-tech-name {
  font-size: 30rpx;
  color: #303133;
  font-weight: bold;
}

.check-icon {
  font-size: 36rpx;
}

/* 技师列表 */
.tech-list {
  padding: 24rpx;
}

.tech-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  position: relative;
  overflow: hidden;
}

.tech-card.selected {
  border-color: #07C160;
  box-shadow: 0 0 0 2rpx rgba(7, 193, 96, 0.15);
}

.tech-card.full {
  opacity: 0.6;
}

/* 约满遮罩 */
.full-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  border-radius: 8rpx;
}

.full-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  background: rgba(245, 108, 108, 0.9);
  padding: 8rpx 32rpx;
  border-radius: 8rpx;
}

.tech-content {
  display: flex;
  align-items: flex-start;
}

.tech-left {
  margin-right: 24rpx;
}

.tech-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.tech-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid #EBEEF5;
}

.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.online-dot.online {
  background: #07C160;
}

.online-dot.offline {
  background: #C0C4CC;
}

.tech-info {
  flex: 1;
}

.tech-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.tech-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #303133;
  margin-right: 12rpx;
}

.level-tag {
  font-size: 20rpx;
  color: #E6A23C;
  background: rgba(230, 162, 60, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.tech-rating {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.rating-star {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.rating-value {
  font-size: 24rpx;
  color: #E6A23C;
}

.tech-skills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.skill-tag {
  font-size: 20rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #C0C4CC;
  font-size: 28rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  color: #909399;
  font-size: 28rpx;
}

/* 底部按钮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn-next {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  text-align: center;
}
