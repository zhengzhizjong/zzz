<view class="container">
  <!-- 疗程卡列表 -->
  <view class="card-list" wx:if="{{cards.length > 0}}">
    <view class="treatment-card" wx:for="{{cards}}" wx:key="id" data-item="{{item}}" bindtap="onCardTap">
      <view class="card-top">
        <view class="card-info">
          <text class="card-name">{{item.cardName}}</text>
          <text class="card-project">{{item.serviceItemName || ''}}</text>
        </view>
        <view class="card-count">
          <text class="count-remaining">{{item.remainingCount}}</text>
          <text class="count-total">/{{item.totalCount}}次</text>
        </view>
      </view>

      <!-- 进度条 -->
      <view class="progress-bar">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{item.progress}}%"></view>
        </view>
        <text class="progress-text">已用{{item.progress}}%</text>
      </view>

      <!-- 有效期 -->
      <view class="card-footer">
        <text class="card-validity">有效期至 {{item.expiryDate || '长期有效'}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && cards.length === 0}}">
    <text class="empty-text">暂无疗程卡</text>
  </view>

  <!-- 加载提示 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 使用记录弹窗 -->
  <view class="popup-mask" wx:if="{{showUsagePopup}}" bindtap="onClosePopup"></view>
  <view class="popup-content" wx:if="{{showUsagePopup}}">
    <view class="popup-header">
      <text class="popup-title">使用记录</text>
      <text class="popup-close" bindtap="onClosePopup">×</text>
    </view>
    <view class="popup-card-name" wx:if="{{currentCard}}">
      <text>{{currentCard.cardName}}</text>
    </view>
    <view class="usage-list" wx:if="{{usageHistory.length > 0}}">
      <view class="usage-item" wx:for="{{usageHistory}}" wx:key="id">
        <view class="usage-left">
          <text class="usage-service">{{item.serviceItemName || '服务'}}</text>
          <text class="usage-date">{{item.usedAt}}</text>
        </view>
        <text class="usage-count">-1次</text>
      </view>
    </view>
    <view class="usage-empty" wx:if="{{usageHistory.length === 0}}">
      <text>暂无使用记录</text>
    </view>
  </view>
</view>
