.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 20rpx;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background-color: #ffffff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
  position: relative;
}

.tab-name {
  font-size: 28rpx;
  color: #909399;
}

.tab-active .tab-name {
  color: #07C160;
  font-weight: bold;
}

.tab-line {
  width: 48rpx;
  height: 6rpx;
  background-color: #07C160;
  border-radius: 3rpx;
  margin-top: 8rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 20rpx 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.coupon-left {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #07C160, #06AD56);
  padding: 28rpx 16rpx;
  flex-shrink: 0;
}

.coupon-value {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.coupon-symbol {
  font-size: 28rpx;
  color: #ffffff;
  margin-right: 4rpx;
}

.coupon-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1;
}

.coupon-unit {
  font-size: 28rpx;
  color: #ffffff;
  margin-left: 4rpx;
}

.coupon-threshold {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.coupon-divider {
  width: 2rpx;
  background-color: #EBEEF5;
  margin: 16rpx 0;
}

.coupon-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 28rpx;
  color: #303133;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.coupon-validity {
  font-size: 22rpx;
  color: #909399;
  margin-bottom: 12rpx;
}

.coupon-status-tag {
  align-self: flex-start;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.status-available {
  background-color: #F0F9EB;
  color: #07C160;
}

.status-used {
  background-color: #F4F4F5;
  color: #909399;
}

.status-expired {
  background-color: #F4F4F5;
  color: #C0C4CC;
}

/* 已使用/已过期卡片左侧变灰 */
.coupon-card.used .coupon-left,
.coupon-card.expired .coupon-left {
  background: linear-gradient(135deg, #C0C4CC, #909399);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #C0C4CC;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #C0C4CC;
}
