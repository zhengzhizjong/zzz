.container {
  padding-bottom: 40rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.step-bar {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #EBEEF5;
}

.step {
  font-size: 24rpx;
  color: #909399;
}

.step.active {
  color: #07C160;
  font-weight: bold;
}

.step.done {
  color: #07C160;
}

/* 已选信息 */
.selected-info-bar {
  display: flex;
  padding: 20rpx 28rpx;
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 8rpx;
  gap: 32rpx;
}

.selected-info-item {
  display: flex;
  align-items: center;
}

.selected-info-item .info-label {
  font-size: 26rpx;
  color: #909399;
}

.selected-info-item .info-value {
  font-size: 26rpx;
  color: #303133;
  font-weight: bold;
}

/* 日期横向滚动 */
.date-scroll {
  white-space: nowrap;
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 8rpx;
  padding: 20rpx 0;
}

.date-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  margin: 0 10rpx;
  border-radius: 8rpx;
  border: 2rpx solid #EBEEF5;
  background: #fff;
}

.date-card.selected {
  background: #07C160;
  border-color: #07C160;
}

.date-card.selected .date-weekday,
.date-card.selected .date-display {
  color: #fff;
}

.date-card.disabled {
  background: #F5F7FA;
  border-color: #EBEEF5;
}

.date-card.disabled .date-weekday,
.date-card.disabled .date-display {
  color: #C0C4CC;
}

.date-weekday {
  font-size: 22rpx;
  color: #909399;
  margin-bottom: 4rpx;
}

.date-display {
  font-size: 26rpx;
  color: #303133;
  font-weight: bold;
}

/* 时段网格 */
.slots-section {
  padding: 24rpx;
}

.slots-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.slot-item {
  width: calc(25% - 12rpx);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  border: 2rpx solid #07C160;
  background: #fff;
}

.slot-item.selected {
  background: #07C160;
  border-color: #07C160;
}

.slot-item.selected .slot-text {
  color: #fff;
}

.slot-item.occupied {
  background: #F5F7FA;
  border-color: #EBEEF5;
}

.slot-lock {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.slot-text {
  font-size: 24rpx;
  color: #07C160;
}

.occupied-text {
  color: #C0C4CC;
  font-size: 22rpx;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #C0C4CC;
  font-size: 28rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  color: #909399;
  font-size: 28rpx;
}

/* 提示文字 */
.slot-tip {
  text-align: center;
  padding: 32rpx 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #909399;
}
