.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #07C160 0%, #06AD56 40%, #F5F5F5 40%);
  padding: 0 48rpx;
}

.login-header {
  text-align: center;
  padding: 100rpx 0 80rpx;
}

.logo-wrap {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.app-title {
  display: block;
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.slogan {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-form {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #EBEEF5;
  padding: 24rpx 0;
}

.form-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #303133;
  height: 48rpx;
}

.toggle-pwd {
  font-size: 24rpx;
  color: #07C160;
  padding: 8rpx 16rpx;
}

.login-btn {
  margin-top: 48rpx;
  width: 100%;
}
