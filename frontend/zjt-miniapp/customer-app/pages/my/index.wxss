.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  background: #07C160;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 24rpx;
}

.avatar-wrapper {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #fff;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
}

.nickname {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

.menu-card {
  padding: 0;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #EBEEF5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 28rpx;
  color: #303133;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C0C4CC;
}
