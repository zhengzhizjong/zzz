<view class="container">
  <!-- 头像 -->
  <view class="avatar-section" bindtap="onChooseAvatar">
    <image class="avatar" src="{{avatarUrl || '/assets/icons/user.png'}}" mode="aspectFill" />
    <view class="avatar-edit-hint">
      <text>点击更换头像</text>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" value="{{nickname}}" placeholder="请输入昵称" bindinput="onNicknameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">真实姓名</text>
      <input class="form-input" value="{{realName}}" placeholder="请输入真实姓名" bindinput="onRealNameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <picker class="form-picker" range="{{genderOptions}}" value="{{gender}}" bindchange="onGenderChange">
        <view class="picker-text">{{genderOptions[gender]}}</view>
        <text class="picker-arrow">›</text>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">生日</text>
      <picker class="form-picker" mode="date" value="{{birthday}}" start="1900-01-01" end="2026-12-31" bindchange="onBirthdayChange">
        <view class="picker-text">{{birthday || '请选择生日'}}</view>
        <text class="picker-arrow">›</text>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <text class="form-input form-input-readonly">{{phone || '未绑定'}}</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <button class="btn-primary save-btn" bindtap="onSubmit" disabled="{{submitting}}">
    {{submitting ? '保存中...' : '保存'}}
  </button>
</view>
