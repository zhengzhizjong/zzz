<view class="payment-page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:if="{{orderInfo && !loading}}">
    <!-- 金额展示 -->
    <view class="amount-card">
      <text class="amount-label">支付金额</text>
      <view class="amount-value">
        <text class="amount-symbol">¥</text>
        <text class="amount-number">{{orderInfo.amount || '0.00'}}</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="card order-info">
      <view class="info-row">
        <text class="info-label">门店</text>
        <text class="info-value">{{orderInfo.storeName || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务项目</text>
        <text class="info-value">{{orderInfo.serviceName || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{orderInfo.orderNo || '-'}}</text>
      </view>
      <view class="info-row" wx:if="{{orderInfo.technicianName}}">
        <text class="info-label">技师</text>
        <text class="info-value">{{orderInfo.technicianName}}</text>
      </view>
      <view class="info-row" wx:if="{{orderInfo.appointmentTime}}">
        <text class="info-label">预约时间</text>
        <text class="info-value">{{orderInfo.appointmentTime}}</text>
      </view>
    </view>

    <!-- 支付按钮 -->
    <view class="pay-action">
      <button class="btn-primary pay-btn" loading="{{paying}}" disabled="{{paying}}" bindtap="handlePay">
        微信支付 ¥{{orderInfo.amount || '0.00'}}
      </button>
    </view>
  </block>
</view>
