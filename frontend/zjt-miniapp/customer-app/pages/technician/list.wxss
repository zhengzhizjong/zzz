/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  height: 48rpx;
  line-height: 48rpx;
}

.search-placeholder {
  color: #C0C4CC;
  font-size: 28rpx;
}

/* 技师列表 */
.technician-list {
  padding: 0 24rpx;
}

/* 技师卡片 */
.technician-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.technician-card.card-disabled {
  opacity: 0.7;
}

/* 头像 */
.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #F5F5F5;
}

.avatar-disabled {
  filter: grayscale(100%);
}

/* 在岗状态点 */
.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
}

.online-dot.online {
  background-color: #07C160;
}

.online-dot.offline {
  background-color: #C0C4CC;
}

/* 技师信息 */
.tech-info {
  flex: 1;
  min-width: 0;
}

.tech-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.tech-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #303133;
  margin-right: 12rpx;
}

.text-disabled {
  color: #C0C4CC;
}

/* 技能等级标签 */
.skill-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  color: #FFFFFF;
}

.skill-level-1 {
  background-color: #909399;
}

.skill-level-2 {
  background-color: #07C160;
}

.skill-level-3 {
  background-color: #FF9D00;
}

.skill-level-4 {
  background-color: #FA5151;
}

/* 评分 */
.tech-rating {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.stars {
  display: flex;
  margin-right: 8rpx;
}

.star {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.star-active {
  color: #FF9D00;
}

.star-inactive {
  color: #E4E7ED;
}

.rating-text {
  font-size: 22rpx;
  color: #FF9D00;
}

/* 擅长项目 */
.specialty-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.specialty-tag {
  font-size: 20rpx;
  color: #07C160;
  background-color: rgba(7, 193, 96, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* 约满遮罩 */
.fully-booked-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,0.85) 30%);
}

.fully-booked-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #C0C4CC;
  writing-mode: vertical-rl;
  letter-spacing: 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #C0C4CC;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #C0C4CC;
}
