<view class="container">
  <view class="step-bar">
    <text class="step active">1 选择门店</text>
    <text class="step">2 选择技师</text>
    <text class="step">3 选择时间</text>
    <text class="step">4 确认预约</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <icon type="search" size="14" color="#909399" />
    <input class="search-input" placeholder="搜索门店名称" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <!-- 门店卡片列表 -->
  <view class="store-list" wx:if="{{!loading}}">
    <view class="store-card {{selectedStoreId === item.id ? 'selected' : ''}}"
          wx:for="{{storeList}}" wx:key="id"
          data-id="{{item.id}}" data-name="{{item.name}}"
          bindtap="onStoreTap">
      <view class="store-header">
        <text class="store-name">{{item.name}}</text>
        <view class="status-tag {{item.businessStatus === 1 ? 'open' : 'closed'}}">
          {{item.businessStatus === 1 ? '🟢 营业中' : '🔴 已打烊'}}
        </view>
      </view>
      <view class="store-info">
        <text class="store-address">📍 {{item.address}}</text>
      </view>
      <view class="store-info">
        <text class="store-hours">🕐 {{item.businessHoursStart || '09:00'}} - {{item.businessHoursEnd || '21:00'}}</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{storeList.length === 0}}">
      <text>暂无门店信息</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 底部下一步按钮 -->
  <view class="bottom-bar">
    <button class="btn-next {{selectedStoreId ? '' : 'disabled'}}" bindtap="onNextStep" disabled="{{!selectedStoreId}}">下一步</button>
  </view>
</view>
